# ══════════════════════════════════════════════════════════
# Wander 寄信設定
# 複製呢個檔做 .env 再填自己嘅資料：
#     cp .env.example .env
# ══════════════════════════════════════════════════════════

# ── 方法 1：Gmail（推薦，最簡單）─────────────────────────
# 1. 開兩步驗證：https://myaccount.google.com/security
# 2. 產生 App Password：https://myaccount.google.com/apppasswords
#    ⚠️ 唔可以用登入密碼！Google 已經封鎖咗。
# 3. 將 16 位密碼（有空格都照填）填落下面
WANDER_SMTP_HOST=smtp.gmail.com
WANDER_SMTP_PORT=587
WANDER_SMTP_USER=yourname@gmail.com
WANDER_SMTP_PASS=abcd efgh ijkl mnop
WANDER_MAIL_FROM=Wander <yourname@gmail.com>

# ── 方法 2：Resend（唔使自己開 SMTP，每月免費 3000 封）──
# https://resend.com 註冊 → API Keys → 建立
# WANDER_RESEND_KEY=re_xxxxxxxxxxxx
# WANDER_MAIL_FROM=Wander <onboarding@resend.dev>


# ══════════════════════════════════════════════════════════════
# （可選）IG 自動抓取 —— 第三方服務
# ══════════════════════════════════════════════════════════════
#
# ⚠️ 老實講：IG 對所有未登入嘅 server 請求一律回傳 JS 空殼（零資料）。
#    我實測過全部失敗：直接抓 HTML、/embed/captioned/、oembed、
#    ?__a=1、r.jina.ai reader —— 冇一個得。
#
#    「點解人哋啲 app 做到？」→ 佢哋**俾錢**買第三方抓取服務。
#    呢啲服務自己養住宅代理 + 帳號池 + 反偵測，成本轉嫁落你身上。
#
#    所以呢個係**可選**嘅。唔配置 = 完全免費（用書籤小工具／貼 caption）。
#    配置咗 = IG link 一貼就自動抽出，唔使貼 caption。
#
# 免費額度（全部唔使信用卡）：
#   scrapecreators  100 次   約 $1.88 / 1000 次   https://scrapecreators.com
#   socialfetch     100 次   約 $1.65 / 1000 次   https://app.socialfetch.dev
#   hikerapi        約100次  約 $0.60 / 1000 次   https://hikerapi.com  ← 最平
#
# ⚠️ 合規：回傳嘅係公開可見內容，但 IG ToS 明文禁止自動化存取。
#    合規責任喺用家身上。想零風險就用書籤小工具。
#
# 用法（取消註解，填你嘅 key）：
# WANDER_IG_PROVIDER=scrapecreators
# WANDER_IG_KEY=your_api_key_here

# ── 開發版後台 ────────────────────────────────────────────────────
# ⚠️ 逗號分隔嘅 email —— 只有呢啲帳號睇得到 /admin 後台。
# ⚠️ 預設**空** = 冇人有後台權限（唔可以有永遠 admin 嘅後門帳號）。
#    例：WANDER_ADMIN_EMAILS=you@gmail.com,you@work.com
WANDER_ADMIN_EMAILS=

# ── 註冊模式 ──────────────────────────────────────────────────────
# ⚠️ 冇設定 = 自動判斷：
#      有 SMTP → email（寄驗證碼）
#      冇 SMTP → invite（要邀請碼，推薦）
#
#   open   —— 任何人都可以註冊（⚠️ 公開上網有風險）
#   invite —— 要邀請碼（邀請碼喺「設定 → 開發版後台」產生）
#   email  —— 要 email 驗證碼（要設定上面嘅 SMTP）
#
# ⚠️ 詳情見 docs/smtp/README.md
WANDER_SIGNUP_MODE=
